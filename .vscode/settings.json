{
	"search.exclude": {
		"**/sorbet/rbi": true,
	},
	"sorbet.enabled": false,
	"[json]": {
		"editor.formatOnSave": true
	},
	"json.validate.enable": true,
	"json.schemaDownload.enable": true,
	"json.schemas": [
		{
			"fileMatch": [
				"rust/optify/tests/**/*.json",
				"tests/{invalid_suites,test_suites}/**/configs/**/*.json",
				"!tests/test_suites/configurable_values/configs/**/*.json",
				"!tests/test_suites/inheritance/configs/**/*.json",
				"!tests/**/configs/.optify/config.json",
				"!tests/**/configs/.optify/schema.json",
				"!tests/**/configs/.optify/policies.json",
				"!rust/optify/tests/**/.optify/policies.json"
			],
			"url": "./schemas/feature_file.json"
		},
		{
			"fileMatch": [
				"tests/test_suites/configurable_values/configs/**/*.json",
				"!tests/test_suites/configurable_values/configs/.optify/config.json",
				"!tests/test_suites/configurable_values/configs/.optify/schema.json"
			],
			"url": "./tests/test_suites/configurable_values/configs/.optify/schema.json"
		},
		{
			"fileMatch": [
				"tests/test_suites/inheritance/configs/**/*.json",
				"!tests/test_suites/inheritance/configs/.optify/schema.json"
			],
			"url": "./tests/test_suites/inheritance/configs/.optify/schema.json"
		},
		{
			"fileMatch": [
				"tests/**/configs/.optify/policies.json",
				"rust/optify/tests/**/.optify/policies.json"
			],
			"url": "./schemas/policies_file.json"
		}
	],
	"[markdown]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"yaml.schemas": {
		"./schemas/feature_file.json": [
			"rust/optify/tests/**/*.{yaml,yml}",
			"tests/{test_suites/!(configurable_values|inheritance),invalid_suites}/**/configs/**/*.{yaml,yml}",
			"tests/test_suites/configurable_values_no_schema/configs/**/*.{yaml,yml}"
		],
		"./tests/test_suites/configurable_values/configs/.optify/schema.json": [
			"tests/test_suites/configurable_values/configs/**/*.{yaml,yml}"
		],
		"./tests/test_suites/inheritance/configs/.optify/schema.json": [
			"tests/test_suites/inheritance/configs/**/*.{yaml,yml}"
		]
	},
	"cSpell.words": [
		"optifile"
	]
}