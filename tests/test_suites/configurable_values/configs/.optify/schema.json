{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Optify Feature Configuration",
	"description": "Schema for Optify feature configuration files supporting JSON and YAML formats. See https://github.com/juharris/optify for more information.",
	"type": "object",
	"additionalProperties": false,
	"minProperties": 1,
	"properties": {
		"conditions": {
			"$ref": "../../../../../schemas/feature_file.json#/definitions/conditions"
		},
		"imports": {
			"$ref": "../../../../../schemas/feature_file.json#/definitions/imports"
		},
		"metadata": {
			"$ref": "../../../../../schemas/feature_file.json#/definitions/metadata"
		},
		"options": {
			"type": "object",
			"description": "The actual configuration options. The value for each key can be any of the following: object, array, string, number, boolean, or null.",
			"minProperties": 1,
			"properties": {
				"greeting": {
					"$ref": "../../../../../schemas/feature_file.json#/definitions/configurableString"
				},
				"message": {
					"$ref": "../../../../../schemas/feature_file.json#/definitions/configurableString"
				},
				"tools": {
					"definitions": {
						"tool": {
							"$dynamicAnchor": "configurableListValue",
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"description": {
									"$ref": "https://raw.githubusercontent.com/juharris/optify/refs/heads/main/schemas/feature_file.json#/definitions/configurableString"
								},
								"name": {
									"type": "string"
								}
							}
						}
					},
					"$ref": "../../../../../schemas/feature_file.json#/definitions/configurableList"
				}
			}
		}
	}
}