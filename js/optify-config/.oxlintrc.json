{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript"],
	"env": {
		"node": true,
		"jest": true
	},
	"categories": {
		"correctness": "error",
		"suspicious": "error"
	},
	"rules": {
		"no-underscore-dangle": "off"
	},
	"ignorePatterns": ["dist/**", "npm/**", "node_modules/**", "target/**"]
}
